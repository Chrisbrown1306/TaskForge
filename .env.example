# Copy to .env for local runs. Never commit the real .env.
TF_REDIS_URL=redis://localhost:6379/0
# Comma-separated; generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TF_API_KEYS=dev-key-change-me
TF_RATE_LIMIT_CAPACITY=20
TF_RATE_LIMIT_REFILL_PER_SEC=10
TF_WORKER_CONCURRENCY=4
TF_EMBEDDED_WORKER=false
TF_LOG_LEVEL=INFO
# Optional: require "Authorization: Bearer <token>" on /metrics
TF_METRICS_TOKEN=
